{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontend Design Galaxy Catalog",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "name",
          "category",
          "source_repo",
          "source_url",
          "remote_url",
          "vibe"
        ],
        "properties": {
          "slug": {"type": "string"},
          "name": {"type": "string"},
          "category": {"type": "string"},
          "source_repo": {"type": "string"},
          "source_url": {"type": "string"},
          "remote_url": {"type": "string"},
          "vibe": {"type": "string"},
          "best_for": {
            "type": "array",
            "items": {"type": "string"}
          },
          "palette_notes": {"type": "string"},
          "typography_notes": {"type": "string"},
          "layout_notes": {"type": "string"},
          "component_notes": {"type": "string"},
          "availability": {"type": "string"},
          "remote_excerpt": {"type": "string"},
          "tags": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
