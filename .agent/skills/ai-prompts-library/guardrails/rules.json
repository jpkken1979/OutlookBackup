{
  "version": "1.0",
  "updated_at": "2026-01-31T13:54:49.291010",
  "rules": [
    {
      "id": "harmful_content",
      "name": "Harmful Content Detection",
      "description": "Detecta solicitudes de contenido dañino",
      "category": "safety",
      "risk_level": "critical",
      "patterns": [
        "(create|write|generate|make)\\s+(malware|virus|trojan|ransomware)",
        "(hack|breach|attack)\\s+(into|a|the)\\s+\\w+",
        "(exploit|vulnerability|zero.?day)",
        "how to (kill|harm|hurt|injure)"
      ],
      "action": "block",
      "message": "Esta solicitud parece requerir contenido potencialmente dañino.",
      "enabled": true
    },
    {
      "id": "personal_info",
      "name": "Personal Information Protection",
      "description": "Protege información personal identificable",
      "category": "privacy",
      "risk_level": "high",
      "patterns": [
        "\\b\\d{3}[-.]?\\d{2}[-.]?\\d{4}\\b",
        "\\b\\d{16}\\b",
        "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b",
        "(password|contraseña|clave)\\s*[:=]\\s*\\S+"
      ],
      "action": "warn",
      "message": "Se detectó información personal que podría ser sensible.",
      "enabled": true
    },
    {
      "id": "illegal_activities",
      "name": "Illegal Activities Prevention",
      "description": "Previene asistencia en actividades ilegales",
      "category": "legal",
      "risk_level": "critical",
      "patterns": [
        "(steal|rob|theft|burglary)",
        "(counterfeit|forge|fake)\\s+(money|currency|documents?)",
        "(drug|narcotic)\\s+(synthesis|manufacture|create)",
        "(weapons?|explosives?|bombs?)\\s+(make|create|build)"
      ],
      "action": "block",
      "message": "No puedo asistir con actividades potencialmente ilegales.",
      "enabled": true
    },
    {
      "id": "misinformation",
      "name": "Misinformation Prevention",
      "description": "Previene la generación de desinformación",
      "category": "accuracy",
      "risk_level": "medium",
      "patterns": [
        "(fake|false)\\s+(news|article|story)",
        "(spread|create)\\s+(rumor|misinformation)",
        "(manipulate|deceive)\\s+(public|people|voters)"
      ],
      "action": "warn",
      "message": "Esta solicitud podría generar desinformación.",
      "enabled": true
    },
    {
      "id": "financial_advice",
      "name": "Financial Advice Disclaimer",
      "description": "Requiere disclaimers para consejos financieros",
      "category": "compliance",
      "risk_level": "low",
      "patterns": [
        "(invest|buy|sell)\\s+(stocks?|crypto|bitcoin|shares?)",
        "(financial|investment)\\s+(advice|recommendation)",
        "(should i|is it good to)\\s+(invest|buy)"
      ],
      "action": "modify",
      "message": "Recuerda incluir disclaimer: No soy asesor financiero.",
      "enabled": true
    },
    {
      "id": "medical_advice",
      "name": "Medical Advice Disclaimer",
      "description": "Requiere disclaimers para consejos médicos",
      "category": "compliance",
      "risk_level": "medium",
      "patterns": [
        "(diagnose|diagnosis|symptoms? of)",
        "(should i take|prescribe|medication for)",
        "(cure|treat|remedy)\\s+for\\s+\\w+"
      ],
      "action": "modify",
      "message": "Disclaimer requerido: Consulta a un profesional médico.",
      "enabled": true
    },
    {
      "id": "code_injection",
      "name": "Code Injection Prevention",
      "description": "Detecta intentos de inyección de código",
      "category": "security",
      "risk_level": "high",
      "patterns": [
        "(eval|exec)\\s*\\(",
        "__import__\\s*\\(",
        "subprocess\\.(call|run|Popen)",
        "os\\.(system|popen)",
        "<script[^>]*>",
        "(union|select|drop|delete|insert)\\s+.*(from|into|table)"
      ],
      "action": "flag",
      "message": "Se detectó código potencialmente peligroso.",
      "enabled": true
    },
    {
      "id": "prompt_injection",
      "name": "Prompt Injection Detection",
      "description": "Detecta intentos de inyección de prompts",
      "category": "security",
      "risk_level": "high",
      "patterns": [
        "ignore\\s+(previous|all|above)\\s+(instructions?|prompts?)",
        "(new|override)\\s+(system|base)\\s+prompt",
        "you are now\\s+\\w+",
        "forget\\s+(everything|your|all)",
        "(jailbreak|bypass|override)\\s+(filters?|rules?|restrictions?)"
      ],
      "action": "block",
      "message": "Se detectó un intento de manipulación del sistema.",
      "enabled": true
    },
    {
      "id": "bias_prevention",
      "name": "Bias Prevention",
      "description": "Previene respuestas sesgadas",
      "category": "ethics",
      "risk_level": "medium",
      "patterns": [
        "(all|every)\\s+(men|women|blacks?|whites?|asians?)\\s+(are|is)",
        "(superior|inferior)\\s+race",
        "(stereotype|generalize)\\s+about\\s+\\w+"
      ],
      "action": "warn",
      "message": "Esta respuesta podría contener sesgos no deseados.",
      "enabled": true
    },
    {
      "id": "copyright_respect",
      "name": "Copyright Protection",
      "description": "Respeta derechos de autor",
      "category": "legal",
      "risk_level": "medium",
      "patterns": [
        "(copy|reproduce|pirate)\\s+(entire|full|complete)\\s+(book|article|song)",
        "(bypass|crack|keygen)\\s+(protection|drm|license)",
        "(torrent|download)\\s+(free|illegal)\\s+\\w+"
      ],
      "action": "warn",
      "message": "Respeta los derechos de autor y propiedad intelectual.",
      "enabled": true
    }
  ]
}