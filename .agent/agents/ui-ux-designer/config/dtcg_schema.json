{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "W3C Design Token Community Group Format",
  "version": "2025.10",
  "type": "object",
  "additionalProperties": {
    "$ref": "#/definitions/tokenGroup"
  },
  "definitions": {
    "tokenGroup": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/definitions/token"},
          {"$ref": "#/definitions/tokenGroup"}
        ]
      }
    },
    "token": {
      "type": "object",
      "required": ["$value", "$type"],
      "properties": {
        "$value": {"type": ["string", "number", "object"]},
        "$type": {
          "type": "string",
          "enum": ["color", "dimension", "fontFamily", "fontWeight", "duration",
                   "cubicBezier", "number", "shadow", "gradient", "typography",
                   "border", "transition", "strokeStyle", "fontStyle", "letterSpacing"]
        },
        "$description": {"type": "string"},
        "$extensions": {"type": "object"}
      }
    }
  }
}
