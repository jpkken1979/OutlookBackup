#!/bin/bash
# clean-gone — Discover local branches whose remote tracking branch is gone
# Usage: scripts/clean-gone

set -euo pipefail

cd "$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "ERROR: Not inside a git repository" >&2
    exit 1
}

# Update refs and detect gone branches
echo "Fetching and pruning remote refs..."
git fetch --prune --quiet 2>/dev/null || true

echo ""
echo "=== Gone branches (local branches with no remote tracking) ==="
echo ""

# git branch -vv shows : [gone] for branches whose remote tracking is gone
git branch -vv | grep ': gone]' | while read -r line; do
    branch="${line%% *}"
    branch="${branch//\*/}"  # remove asterisk if on this branch

    # Check if there's an associated worktree
    worktree_info=""
    if git worktree list | grep -q "$branch"; then
        worktree_path=$(git worktree list | grep "$branch" | awk '{print $1}')
        worktree_info=" [worktree: $worktree_path]"
    fi

    echo "$branch$worktree_info"
done

echo ""
echo "Done. No changes made — run git branch -D <branch> to delete."
