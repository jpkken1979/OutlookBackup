{
  "$schema": "https://schema.anthropic.com/claude-code/skill-rules.json",
  "version": "1.0.0",
  "description": "Custom skills para AntigravitiSkillUSN - Centralizados en .agent/skills-custom/",
  "skills": {
    "startup": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Verifica entorno y lanza servidores FastAPI + React",
      "promptTriggers": {
        "keywords": [
          "startup",
          "iniciar servidores",
          "start servers",
          "launch servers",
          "port conflict",
          "CORS error",
          "server not running"
        ],
        "intentPatterns": [
          "(start|launch|initialize).*?(server|backend|frontend)",
          "(verify|check).*?(environment|setup)",
          "(port|CORS).*?(error|conflict)"
        ]
      }
    },
    "finalizar": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "critical",
      "description": "Workflow de finalización: tests → docs → lint → commit → push",
      "promptTriggers": {
        "keywords": [
          "finalizar",
          "finish",
          "done",
          "wrap up",
          "commit and push",
          "cerrar sesión"
        ],
        "intentPatterns": [
          "(finalizar|finish|complete).*(code|work)",
          "(commit|push).*(and|con).*?(docs)",
          "(end|close).*(session|work)"
        ]
      }
    },
    "finalizar-autonomo": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "critical",
      "description": "Cierre autónomo 7 fases: cambios → tests → docs → lint → commit → push → reporte. CLI, API, Docker, CI/CD. Portable a cualquier LLM.",
      "promptTriggers": {
        "keywords": [
          "finalizar-autonomo",
          "autonomous finalizer",
          "autonomous close",
          "cierre automático",
          "auto-close",
          "sin intervención"
        ],
        "intentPatterns": [
          "(finalizar|close).*(autonomously|automatically)",
          "(autonomous|autónomo).*(finalizer|workflow)",
          "python.*?finalizar.*?autonomo"
        ]
      },
      "portability": {
        "supportsExternal": true,
        "supportsCLI": true,
        "supportsAPI": true,
        "supportsDocker": true,
        "supportsCICDPipelines": true,
        "supportedLLMs": ["claude", "chatgpt", "gemini", "ollama", "any"]
      }
    },
    "type-validation": {
      "type": "guardrail",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Previene type errors ejecutando mypy. Detecta errores, crea plans secuenciales (ONE FILE AT A TIME). Verifica resolución.",
      "promptTriggers": {
        "keywords": [
          "type error",
          "mypy",
          "type check",
          "type validation",
          "type safety",
          "incompatible types"
        ],
        "intentPatterns": [
          "(validate|check|fix).*?(type|mypy)",
          "(run|execute).*?mypy.*?(on|in)",
          "type.*?(error|problem).*?(in|on)",
          "(one|un).*(file|archivo).*(at a time)"
        ]
      }
    },
    "debug-server": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "Diagnostica problemas de servidores: puertos, CORS, .env, conexión",
      "promptTriggers": {
        "keywords": [
          "debug server",
          "server error",
          "port already in use",
          "EADDRINUSE",
          "CORS error",
          "connection refused"
        ]
      }
    },
    "excel-parsing": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "Mejores prácticas para parsear Excel: headers, whitespace, validación",
      "promptTriggers": {
        "keywords": [
          "Excel",
          "xlsx",
          "parse Excel",
          "read spreadsheet",
          "data import",
          "column mapping"
        ]
      }
    }
  }
}
