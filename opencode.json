{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "antigravity": {
      "type": "local",
      "command": [
        "${ANTIGRAVITY_ROOT}/.venv/Scripts/python.exe",
        "-m",
        "core.mcp_stdio_proxy"
      ],
      "enabled": true,
      "environment": {
        "ANTIGRAVITY_ROOT": ".",
        "ANTIGRAVITY_MCP_URL": "http://localhost:4747/mcp",
        "PYTHONPATH": ".agent"
      }
    }
  }
}