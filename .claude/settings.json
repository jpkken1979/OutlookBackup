{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash \".claude/hooks/scripts/run-python.sh\" -X utf8 \".claude/hooks/SessionStop.py\"",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && \".claude/hooks/scripts/memory-sync.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && \".claude/hooks/scripts/claude-md-drift-check.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && \".claude/hooks/scripts/git-status-reminder.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash \".claude/hooks/scripts/run-python.sh\" -X utf8 \".agent/scripts/rebuild_brain_index.py\" --quiet --skip-if-ephemeral",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash \".claude/hooks/scripts/run-python.sh\" -X utf8 \".agent/scripts/brain_lint.py\" --severity error --fail-on never",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\".claude/hooks/scripts/session-report.sh\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && \".claude/hooks/scripts/setup-deps.sh\"",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash \".claude/hooks/scripts/run-python.sh\" -X utf8 \".claude/hooks/scripts/failover_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash \".claude/hooks/scripts/run-python.sh\" -X utf8 \".claude/hooks/scripts/lint_on_edit.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash \".claude/hooks/scripts/run-python.sh\" -X utf8 \".claude/hooks/scripts/complexity_check.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash \".claude/hooks/scripts/run-python.sh\" -X utf8 \".claude/hooks/scripts/frontmatter_validator.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash \".claude/hooks/scripts/run-python.sh\" -X utf8 \".claude/hooks/scripts/rust_check_on_edit.py\"",
            "timeout": 95
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash \".claude/hooks/scripts/run-python.sh\" -X utf8 \".claude/hooks/scripts/security_guard_on_edit.py\"",
            "timeout": 25
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash \".claude/hooks/scripts/run-python.sh\" -X utf8 \".agent/scripts/hook_runner.py\" observation_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash \".claude/hooks/scripts/run-python.sh\" -X utf8 \".agent/hooks/memory/user_prompt_submit.py\"",
            "timeout": 45
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash \".claude/hooks/scripts/run-python.sh\" -X utf8 \".claude/hooks/scripts/team_event_capture.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash \".claude/hooks/scripts/run-python.sh\" -X utf8 \".claude/hooks/scripts/team_event_capture.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash \".claude/hooks/scripts/run-python.sh\" -X utf8 \".claude/hooks/scripts/team_event_capture.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "context": {
    "autoInject": [
      ".claude/rules/*.md"
    ],
    "maxTokens": 24000
  },
  "project": {
    "name": "uns-backup-app-v3.1",
    "description": "Proyecto integrado con Antigravity Agents"
  },
  "permissions": {
    "allow": [
      "write",
      "${USERPROFILE}/Github/Jpkken1979/uns-backup-app-v3.1/src/web/**"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "enableAllProjectMcpServers": true
}